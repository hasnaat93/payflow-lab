# Copy to .env and adjust. These are local-development placeholders, not secrets.
# Never commit a real .env file.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=payflow
POSTGRES_USER=payflow
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Backend ---
# When running the backend outside compose, it reads these three:
DATABASE_URL=jdbc:postgresql://localhost:5432/payflow
DATABASE_USERNAME=payflow
DATABASE_PASSWORD=change-me-locally
BACKEND_PORT=8080
# Comma-separated browser origins allowed to call the API directly. Never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Load the fictional demo dataset when the database is empty.
DEMO_SEED_ON_STARTUP=true
# Allow POST /api/v1/demo/reset (wipes all data). Set to false on any shared deployment.
DEMO_RESET_ENABLED=true
# Optional end-of-day settlement job (UTC cron). Off by default; settlement is operator-triggered.
SETTLEMENT_SCHEDULE_ENABLED=false
SETTLEMENT_SCHEDULE_CRON=0 30 0 * * *

# --- Frontend ---
FRONTEND_PORT=5173
# Only for "npm run dev": where the Vite dev server proxies /api.
VITE_DEV_API_TARGET=http://localhost:8080
